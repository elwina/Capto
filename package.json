{
  "name": "capto-workspace",
  "private": true,
  "scripts": {
    "dev": "npm run tauri --prefix apps/desktop -- dev",
    "build": "npm run tauri --prefix apps/desktop -- build",
    "desktop:install": "npm install --prefix apps/desktop",
    "lint": "npm run lint --prefix apps/desktop",
    "format:check": "npm run format:check --prefix apps/desktop",
    "knip": "npm run knip --prefix apps/desktop",
    "test:ui": "npm test --prefix apps/desktop",
    "coverage": "npm run test:coverage --prefix apps/desktop",
    "check": "npm run lint --prefix apps/desktop && npm run format:check --prefix apps/desktop && npm run knip --prefix apps/desktop",
    "ffmpeg:copy": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/copy-ffmpeg.ps1",
    "test:rust": "cargo test --workspace",
    "cli": "cargo run -p capto-cli --",
    "skill:pack": "npm pack ./packages/capto-agent-skill",
    "skill:publish": "npm publish ./packages/capto-agent-skill --access public"
  }
}
