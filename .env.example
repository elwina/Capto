# Capto local development environment variables.
# Copy to `.env` if you want to persist overrides (`.env` is gitignored).
# None of these are required — the app works out of the box with defaults.

# Path to a pre-built `capto-app.exe` used by the `capto` CLI / agents to
# auto-launch the desktop when the control plane is down.
# (Only needed when you build the desktop separately from the CLI checkout.)
# CAPTO_APP_PATH=D:\AIWorkspace\Capto\target\debug\capto-app.exe

# Rust logging filter for the CLI / desktop (tracing-subscriber env-filter).
# Example: RUST_LOG=debug,capto_core=info
# RUST_LOG=warn

# Print full Rust backtraces for panics during development.
# RUST_BACKTRACE=1

# CI-only signing keys for Tauri updater artifacts (do NOT set locally).
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
